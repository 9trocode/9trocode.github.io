{
  "$schema": "https://schema.railpack.com",
  "provider": "ruby",
  "packages": {
    "ruby": "3.1"
  },
  "steps": {
    "install": {
      "commands": [
        "..."
      ]
    },
    "build": {
      "inputs": [
        { "step": "install" },
        { "local": true, "include": ["."] }
      ],
      "commands": [
        "JEKYLL_ENV=production bundle exec jekyll build"
      ]
    }
  },
  "deploy": {
    "inputs": [
      "...",
      { "step": "build", "include": ["_site"] }
    ],
    "startCommand": "bundle exec ruby -run -e httpd _site -p ${PORT:-8080} -b 0.0.0.0",
    "variables": {
      "JEKYLL_ENV": "production",
      "LANG": "en_US.UTF-8",
      "LC_ALL": "en_US.UTF-8",
      "BUNDLE_GEMFILE": "/app/Gemfile"
    }
  }
}
